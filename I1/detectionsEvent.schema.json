{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DetectionsEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.i1.detections"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "image_width": {
          "type": "integer",
          "minimum": 1
        },
        "image_height": {
          "type": "integer",
          "minimum": 1
        },
        "detections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "detection_id": {
                "type": "integer",
                "minimum": 0
              },
              "class": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bbox": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": ["detection_id", "class", "confidence", "bbox"]
          }
        }
      },
      "required": ["frame_index", "image_width", "image_height", "detections"]
    }
  },
  "required": [
    "schema",
    "message_type",
    "producer",
    "artifact_version",
    "payload"
  ]
}
