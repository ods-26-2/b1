{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FacialMarkerEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.i4.facial_marker"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "marker": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["marker", "confidence", "start_at", "end_at"]
    }
  },
  "required": [
    "schema",
    "message_type",
    "producer",
    "artifact_version",
    "payload"
  ]
}
