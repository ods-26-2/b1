{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AudioChunkEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.p5.audio_chunk"
    },
    "producer": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "chunk_index": {
          "type": "integer",
          "minimum": 0
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "sample_format": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "chunk_index",
        "sample_rate",
        "channels",
        "sample_format",
        "duration_ms"
      ]
    }
  },
  "required": [
    "schema",
    "producer",
    "captured_at",
    "source_id",
    "session_id",
    "payload"
  ]
}
