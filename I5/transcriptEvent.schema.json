{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.i5.transcript"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "transcribed_text": {
          "type": "string"
        },
        "normalized_text": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}-[A-Z]{2}$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertain": {
          "type": "boolean"
        },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "start_at": {
                "type": "string",
                "format": "date-time"
              },
              "end_at": {
                "type": "string",
                "format": "date-time"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["text", "start_at", "end_at", "confidence"]
          }
        }
      },
      "required": [
        "start_at",
        "end_at",
        "transcribed_text",
        "normalized_text",
        "language",
        "confidence",
        "uncertain",
        "words"
      ]
    }
  },
  "required": [
    "schema",
    "message_type",
    "producer",
    "source_id",
    "artifact_version",
    "payload"
  ]
}
