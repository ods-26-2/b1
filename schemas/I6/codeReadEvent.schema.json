{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeReadEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.i6.code_read"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "code_type": {
          "type": "string",
          "enum": ["QR_CODE", "CODE_128", "EAN_13"]
        },
        "decoded_data": {
          "type": "string"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["frame_index", "code_type", "decoded_data", "bbox"]
    }
  },
  "required": [
    "schema",
    "message_id",
    "message_type",
    "producer",
    "source_id",
    "artifact_version",
    "payload"
  ]
}
