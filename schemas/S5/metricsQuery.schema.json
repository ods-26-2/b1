{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricsQuery",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.s5.metrics.query"
    },
    "message_type": {
      "type": "string",
      "const": "query"
    },
    "producer": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "enum": ["ZONE", "EVENT"]
        },
        "zone_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "period_start_at": {
          "type": "string",
          "format": "date-time"
        },
        "period_end_at": {
          "type": "string",
          "format": "date-time"
        },
        "granularity": {
          "type": "string",
          "enum": ["1m", "15m", "1h", "1d"]
        }
      },
      "required": [
        "metric",
        "period_start_at",
        "period_end_at",
        "granularity"
      ]
    }
  },
  "required": ["schema", "message_type", "producer", "target", "payload"]
}
