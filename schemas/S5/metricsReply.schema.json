{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricsReply",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.s5.metrics.reply"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_type": {
      "type": "string",
      "const": "reply"
    },
    "producer": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["OK", "ERROR"]
        },
        "series": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "zone_id": {
                    "type": "string"
                  },
                  "class": {
                    "type": "string"
                  },
                  "space_id": {
                    "type": "string"
                  },
                  "window_start_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "window_end_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "granularity": {
                    "type": "string",
                    "enum": ["1m", "15m", "1h", "1d"]
                  },
                  "total_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "occupancy_peak": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "occupancy_avg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "dwell_avg_s": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "zone_id",
                  "window_start_at",
                  "window_end_at",
                  "granularity",
                  "total_count",
                  "occupancy_peak",
                  "occupancy_avg",
                  "dwell_avg_s"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "event_type": {
                    "type": "string"
                  },
                  "zone_id": {
                    "type": "string"
                  },
                  "class": {
                    "type": "string"
                  },
                  "window_start_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "window_end_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "granularity": {
                    "type": "string",
                    "enum": ["1m", "15m", "1h", "1d"]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uncertain_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "duration_avg_ms": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "event_type",
                  "window_start_at",
                  "window_end_at",
                  "granularity",
                  "count",
                  "uncertain_count"
                ]
              }
            ]
          },
          "maxItems": 1000
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": ["PERIOD_TOO_LONG", "UNKNOWN_ZONE"]
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["code", "message"]
        }
      },
      "required": ["status"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "OK"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["series"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ERROR"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["error"]
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "message_type",
    "producer",
    "correlation_id",
    "payload"
  ]
}
