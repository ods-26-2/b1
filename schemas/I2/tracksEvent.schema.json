{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TracksEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.i2.tracks"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "track_id": {
                "type": "string"
              },
              "detection_id": {
                "type": "integer",
                "minimum": 0
              },
              "class": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": ["CONFIRMED", "LOST"]
              },
              "predicted": {
                "type": "boolean"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "point_px": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "bbox": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "track_id",
              "class",
              "state",
              "predicted",
              "confidence",
              "point_px",
              "bbox"
            ]
          }
        }
      },
      "required": ["frame_index", "tracks"]
    }
  },
  "required": [
    "schema",
    "message_type",
    "producer",
    "artifact_version",
    "payload"
  ]
}
