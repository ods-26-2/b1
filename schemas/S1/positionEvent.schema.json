{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PositionEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.s1.position"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "track_id": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "point_px": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "position_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "space_id": {
                "type": "string"
              },
              "zone_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["track_id", "class", "point_px", "zone_ids"]
          }
        }
      },
      "required": ["frame_index", "positions"]
    }
  },
  "required": [
    "schema",
    "message_id",
    "message_type",
    "producer",
    "source_id",
    "artifact_version",
    "payload"
  ]
}
