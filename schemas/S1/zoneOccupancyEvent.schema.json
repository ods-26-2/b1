{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZoneOccupancyEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.s1.zone_occupancy"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "zone_id": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "count_by_class": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "max_occupancy": {
          "type": "integer",
          "minimum": 0
        },
        "track_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["zone_id", "count", "count_by_class", "track_ids"]
    }
  },
  "required": [
    "schema",
    "message_id",
    "message_type",
    "producer",
    "source_id",
    "artifact_version",
    "payload"
  ]
}
