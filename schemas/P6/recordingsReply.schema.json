{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordingsReply",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.p6.recordings.reply"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_type": {
      "type": "string",
      "const": "reply"
    },
    "producer": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["OK", "ERROR"]
        },
        "recordings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recording_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "ended_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "recording_id",
              "started_at",
              "ended_at",
              "sources",
              "duration_ms"
            ]
          }
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["code", "message"]
        }
      },
      "required": ["status"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "OK"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["recordings"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ERROR"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["error"]
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "message_type",
    "producer",
    "correlation_id",
    "payload"
  ]
}
