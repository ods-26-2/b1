{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlertsReply",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.s3.alerts.reply"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_type": {
      "type": "string",
      "const": "reply"
    },
    "producer": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["OK", "ERROR"]
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alert_id": {
                "type": "string",
                "format": "uuid"
              },
              "event_id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": ["HIGH", "MEDIUM", "LOW"]
              },
              "recipients": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(user|group|role):.+$"
                }
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["SOUND", "SCREEN", "PUSH"]
                }
              },
              "clip_id": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "type": "string",
                "enum": ["CREATED", "ACKNOWLEDGED", "MUTED", "CLOSED"]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "acknowledged_by": {
                "type": "string"
              },
              "acknowledged_at": {
                "type": "string",
                "format": "date-time"
              },
              "muted_until": {
                "type": "string",
                "format": "date-time"
              },
              "closed_by": {
                "type": "string"
              },
              "closed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "alert_id",
              "title",
              "message",
              "severity",
              "recipients",
              "channels",
              "state",
              "created_at"
            ]
          }
        },
        "next_from_at": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["code", "message"]
        }
      },
      "required": ["status"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "OK"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["alerts"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ERROR"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["error"]
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "message_id",
    "message_type",
    "producer",
    "correlation_id",
    "payload"
  ]
}
