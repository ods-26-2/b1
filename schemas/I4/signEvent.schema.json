{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.i4.sign"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "artifact_version": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "sign": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sign": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["sign", "confidence"]
          },
          "maxItems": 5
        },
        "signer_id": {
          "type": "string"
        }
      },
      "required": ["sign", "confidence", "start_at", "end_at"]
    }
  },
  "required": [
    "schema",
    "message_type",
    "producer",
    "artifact_version",
    "payload"
  ]
}
