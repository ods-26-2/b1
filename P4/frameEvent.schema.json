{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.p4.frame"
    },
    "producer": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "image_width": {
          "type": "integer",
          "minimum": 1
        },
        "image_height": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_format": {
          "type": "string"
        },
        "fps": {
          "type": "number",
          "minimum": 0
        },
        "raw": {
          "type": "boolean"
        }
      },
      "required": [
        "frame_index",
        "image_width",
        "image_height",
        "pixel_format",
        "fps",
        "raw"
      ]
    }
  },
  "required": [
    "schema",
    "producer",
    "captured_at",
    "source_id",
    "session_id",
    "payload"
  ]
}
